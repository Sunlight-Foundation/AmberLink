// bench/methods.amb — method-call + field dispatch overhead. Higher is worse.
class Counter {
    int count

    void add(int val) {
        this.count = this.count + val
    }
}

float t0 = clock()
var c = new Counter()
c.count = 0
int i = 0
while i < 2000000 {
    c.add(1)
    i = i + 1
}
print c.count
print clock() - t0
