// stdlib/ffi.amb
// FFI: call C functions in shared libraries (VM natives, v1).
// Only int and string arguments are marshalled:
//   loadLib(path) : int               — handle, or 0 on failure
//   freeLib(handle) : bool            — true if a library was closed
//   callInt(handle, symbol, a, b) : int   — calls int f(int, int)
//   callStr(handle, symbol, s) : int      — calls int f(const char*)
// A bad handle or missing symbol is a runtime error; calling with the
// wrong C signature is undefined (as in C).

int lib = loadLib("msvcrt.dll")
if lib == 0 {
    lib = loadLib("libc.so.6")
}
print callStr(lib, "atoi", "42")       // 42
print callStr(lib, "strlen", "hello")  // 5
print callInt(lib, "div", 7, 2)        // 3 (quotient)
print freeLib(lib)                     // true
